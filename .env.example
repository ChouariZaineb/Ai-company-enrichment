# Google Gemini API Keys (comma-separated for rotation across multiple free-tier keys)
GEMINI_API_KEY=your_gemini_key_here,another_key_here

# Gemini Pro API Key (dedicated pro key with proper quota)
GEMINI_PRO_API_KEY=your_gemini_pro_key_here

# AWS Bedrock Credentials (for Claude and DeepSeek models)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Bedrock Inference Profile ARN for Claude Sonnet 5 (multi-agent pipeline)
BEDROCK_INFERENCE_PROFILE_ARN_sonnet5=your_bedrock_inference_profile_arn
